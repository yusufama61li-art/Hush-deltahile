-- 🔓 GİRİŞ KONTROLÜ (ZAMAN KONTROLLÜ)
-- ============================================
submitBtn.MouseButton1Click:Connect(function()
    local enteredKey = inputBox.Text
    if enteredKey == "" then return end
    
    errorMsg.Text = "⏳ Kontrol ediliyor..."
    errorMsg.TextColor3 = Color3.fromRGB(255, 200, 50)
    
    task.wait(0.5)
    
    -- O anki geçerli şifreyi hesaplar
    local currentTrueKey = GetCurrentSecretKey()
    
    if string.gsub(enteredKey, "%s+", ""):upper() == currentTrueKey then
        errorMsg.Text = "✅ Şifre Doğru! Menü Yükleniyor..."
        errorMsg.TextColor3 = Color3.fromRGB(80, 255, 150)
        task.wait(1)
        KeyGui:Destroy()
        HushMenuAc() -- Menüyü başlat
    else
        errorMsg.Text = "❌ Geçersiz Şifre! Süresi dolmuş veya yanlış."
        errorMsg.TextColor3 = Color3.fromRGB(255, 50, 80)
        inputBox.Text = ""
    end
end)
